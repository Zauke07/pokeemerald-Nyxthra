Route119_MapScripts::
	map_script MAP_SCRIPT_ON_RESUME, Route119_OnResume
	map_script MAP_SCRIPT_ON_TRANSITION, Route119_OnTransition
	.byte 0

Route119_OnResume:
	call_if_set FLAG_SYS_CTRL_OBJ_DELETE, Route119_EventScript_TryRemoveKecleon
	end

Route119_EventScript_TryRemoveKecleon::
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, Common_EventScript_NopReturn
	removeobject VAR_LAST_TALKED
	return

Route119_OnTransition:
	call Common_EventScript_SetupRivalGfxId_FromPlayerStyle
	call Common_EventScript_SetupRivalOnBikeGfxId_Route110
	setflag FLAG_HIDE_ROUTE_119_RIVAL
	setflag FLAG_HIDE_ROUTE_119_RIVAL_ON_BIKE
	removeobject LOCALID_ROUTE119_RIVAL
	removeobject LOCALID_ROUTE119_RIVAL_ON_BIKE
	call_if_eq VAR_WEATHER_INSTITUTE_STATE, 1, Route119_EventScript_MoveInstituteWorkersDownstairs
	special SetRoute119Weather
	end

Route119_EventScript_MoveInstituteWorkersDownstairs::
	setflag FLAG_HIDE_WEATHER_INSTITUTE_2F_WORKERS
	clearflag FLAG_HIDE_WEATHER_INSTITUTE_1F_WORKERS
	setvar VAR_WEATHER_INSTITUTE_STATE, 2
	return

Route119_EventScript_RivalTrigger1::
	setvar VAR_TEMP_1, 1
	goto Route119_EventScript_RivalEncounter
	end

Route119_EventScript_RivalTrigger2::
	setvar VAR_TEMP_1, 2
	goto Route119_EventScript_RivalEncounter
	end

Route119_EventScript_RivalEncounter::
	lockall
	addobject LOCALID_ROUTE119_RIVAL_ON_BIKE
	call Common_EventScript_SetupRivalMusic
	delay 65
	call_if_eq VAR_TEMP_1, 1, Route119_EventScript_RivalEnter1
	call_if_eq VAR_TEMP_1, 2, Route119_EventScript_RivalEnter2
	applymovement OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	delay 30
	call_if_eq VAR_TEMP_1, 1, Route119_EventScript_SetRivalPos1
	call_if_eq VAR_TEMP_1, 2, Route119_EventScript_SetRivalPos2
	removeobject LOCALID_ROUTE119_RIVAL_ON_BIKE
	addobject LOCALID_ROUTE119_RIVAL
	delay 30
	getplayerstyle
	copyvar VAR_TEMP_2, VAR_RESULT
	compare VAR_TEMP_2, STYLE_BRENDAN
	call_if_eq Route119_EventScript_ShowMayIntro
	compare VAR_TEMP_2, STYLE_MAY
	call_if_eq Route119_EventScript_ShowBrendanIntro
	compare VAR_TEMP_2, STYLE_RED
	call_if_eq Route119_EventScript_ShowMayIntro
	compare VAR_TEMP_2, STYLE_LEAF
	call_if_eq Route119_EventScript_ShowBrendanIntro
	compare VAR_TEMP_2, STYLE_ETHAN
	call_if_eq Route119_EventScript_ShowMayIntro
	compare VAR_TEMP_2, STYLE_LYRA
	call_if_eq Route119_EventScript_ShowBrendanIntro
	compare VAR_TEMP_2, STYLE_LUCAS
	call_if_eq Route119_EventScript_ShowMayIntro
	compare VAR_TEMP_2, STYLE_DAWN
	call_if_eq Route119_EventScript_ShowBrendanIntro
	compare VAR_TEMP_2, STYLE_HILBERT
	call_if_eq Route119_EventScript_ShowMayIntro
	compare VAR_TEMP_2, STYLE_HILDA
	call_if_eq Route119_EventScript_ShowBrendanIntro
	compare VAR_TEMP_2, STYLE_NATE
	call_if_eq Route119_EventScript_ShowMayIntro
	compare VAR_TEMP_2, STYLE_ROSA
	call_if_eq Route119_EventScript_ShowBrendanIntro
	compare VAR_TEMP_2, STYLE_CALEM
	call_if_eq Route119_EventScript_ShowMayIntro
	compare VAR_TEMP_2, STYLE_SERENA
	call_if_eq Route119_EventScript_ShowBrendanIntro
	compare VAR_TEMP_2, STYLE_ELIO
	call_if_eq Route119_EventScript_ShowMayIntro
	compare VAR_TEMP_2, STYLE_SELENE
	call_if_eq Route119_EventScript_ShowBrendanIntro
	compare VAR_TEMP_2, STYLE_VICTOR
	call_if_eq Route119_EventScript_ShowMayIntro
	compare VAR_TEMP_2, STYLE_GLORIA
	call_if_eq Route119_EventScript_ShowBrendanIntro
	compare VAR_TEMP_2, STYLE_FLORIAN
	call_if_eq Route119_EventScript_ShowMayIntro
	compare VAR_TEMP_2, STYLE_JULIANA
	call_if_eq Route119_EventScript_ShowBrendanIntro
	switch VAR_TEMP_2
	case STYLE_BRENDAN, Route119_EventScript_StartBattle_May
	case STYLE_MAY, Route119_EventScript_StartBattle_Brendan
	case STYLE_RED, Route119_EventScript_StartBattle_Leaf
	case STYLE_LEAF, Route119_EventScript_StartBattle_Red
	case STYLE_ETHAN, Route119_EventScript_StartBattle_Lyra
	case STYLE_LYRA, Route119_EventScript_StartBattle_Ethan
	case STYLE_LUCAS, Route119_EventScript_StartBattle_Dawn
	case STYLE_DAWN, Route119_EventScript_StartBattle_Lucas
	case STYLE_HILBERT, Route119_EventScript_StartBattle_Hilda
	case STYLE_HILDA, Route119_EventScript_StartBattle_Hilbert
	case STYLE_NATE, Route119_EventScript_StartBattle_Rosa
	case STYLE_ROSA, Route119_EventScript_StartBattle_Nate
	case STYLE_CALEM, Route119_EventScript_StartBattle_Serena
	case STYLE_SERENA, Route119_EventScript_StartBattle_Calem
	case STYLE_ELIO, Route119_EventScript_StartBattle_Selene
	case STYLE_SELENE, Route119_EventScript_StartBattle_Elio
	case STYLE_VICTOR, Route119_EventScript_StartBattle_Gloria
	case STYLE_GLORIA, Route119_EventScript_StartBattle_Victor
	case STYLE_FLORIAN, Route119_EventScript_StartBattle_Juliana
	case STYLE_JULIANA, Route119_EventScript_StartBattle_Florian
	releaseall
	end

